#. Plugin Name of the plugin
#: selective-entity-sync.php:3
#: src/Admin/AdminPage.php:81
#: src/Admin/AdminPage.php:82
#: src/Admin/AdminPage.php:99
msgid "Selective Entity Sync"
msgstr "Selective Entity Sync"

#. Plugin URI of the plugin
#: selective-entity-sync.php:4
msgid "https://github.com/gabriel-detassigny/selective-entity-sync"
msgstr "https://github.com/gabriel-detassigny/selective-entity-sync"

#. Description of the plugin
#: selective-entity-sync.php:5
msgid "Push selected content (posts, pages, custom post types, terms and media) from one WordPress site to another (e.g. staging to production) using entity manifests, with automatic ID remapping, so live data is never overwritten."
msgstr "Transférez des contenus choisis (articles, pages, types de contenu personnalisés, termes et médias) d’un site WordPress à un autre (par exemple de la préproduction vers la production) grâce à des manifestes d’entités, avec réattribution automatique des identifiants, sans jamais écraser les données en ligne."

#. Author of the plugin
#: selective-entity-sync.php:9
msgid "Gabriel de Tassigny"
msgstr "Gabriel de Tassigny"

#: selective-entity-sync.php:42
msgid "Selective Entity Sync is missing its dependencies. Please run \"composer install\" or install a release build of the plugin."
msgstr "Il manque des dépendances à Selective Entity Sync. Lancez « composer install » ou installez une version publiée de l’extension."

