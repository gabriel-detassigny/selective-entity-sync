{
  "name": "gabriel-detassigny/selective-entity-sync",
  "description": "Push selected content (posts, terms, media) between WordPress sites (e.g. staging to production) via entity manifests, with automatic ID remapping.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Gabriel de Tassigny"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0",
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "~6.9.0",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-cli/i18n-command": "^2.7",
    "wp-coding-standards/wpcs": "^3.1",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "SelectiveEntitySync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SelectiveEntitySync\\Tests\\Unit\\": "tests/unit/",
      "SelectiveEntitySync\\Tests\\Integration\\": "tests/integration/"
    }
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test:unit": "phpunit -c phpunit-unit.xml.dist",
    "test:integration": "phpunit -c phpunit.xml.dist",
    "makepot": "wp i18n make-pot . languages/selective-entity-sync.pot --domain=selective-entity-sync --exclude=node_modules,vendor,src-js,tests,artifacts,test-results,playwright-report,.internal --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/gabriel-detassigny/selective-entity-sync/issues\"}'",
    "makemo": "wp i18n make-mo languages",
    "makejson": "wp i18n make-json languages",
    "updatepo": "wp i18n update-po languages/selective-entity-sync.pot languages/"
  },
  "scripts-descriptions": {
    "makepot": "Regenerate languages/selective-entity-sync.pot from PHP and build/ (run npm run build first).",
    "makemo": "Compile languages/*.po to .mo (PHP translations).",
    "makejson": "Generate JavaScript translation files from languages/*.po.",
    "updatepo": "Merge new and changed strings from the POT file into languages/*.po."
  }
}
